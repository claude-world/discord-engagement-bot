{
  "name": "discord-engagement-bot",
  "version": "1.0.0",
  "description": "Claude World Taiwan Discord community engagement bot with Electron menubar",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "backfill": "tsx src/backfill.ts",
    "dev:ui": "vite ui",
    "build": "tsc && vite build ui",
    "electron:dev": "concurrently \"vite ui\" \"tsc -w\" \"electron .\"",
    "electron:build": "tsc && vite build ui && electron-builder",
    "package": "npm run build && electron-builder --mac",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "electron-store": "^10.0.0",
    "menubar": "^9.5.0",
    "node-cron": "^3.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  },
  "overrides": {
    "undici": "^7.5.0",
    "tar": "^7.5.11",
    "@tootallnate/once": "^3.0.1",
    "yauzl": "^3.2.1"
  }
}
