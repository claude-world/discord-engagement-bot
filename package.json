{
  "name": "discord-engagement-bot",
  "version": "1.1.0",
  "description": "Claude World Taiwan Discord community engagement bot with Electron menubar",
  "main": "dist/electron/main.js",
  "bin": {
    "engagement-bot": "./bin/bot.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "cli": "tsx src/cli.ts",
    "bot": "tsx src/cli.ts",
    "backfill": "tsx src/backfill.ts",
    "dev:ui": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently \"vite\" \"tsc -w\" \"electron .\"",
    "electron:build": "tsc && vite build && electron-builder",
    "package": "npm run build && electron-builder --mac",
    "lint": "tsc --noEmit && tsc -p ui && tsc -p test",
    "test": "tsx --test \"test/*.test.ts\""
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "menubar": "^9.5.3",
    "node-cron": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
