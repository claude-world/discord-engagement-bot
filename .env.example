# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Guild (Server) ID
DISCORD_GUILD_ID=

# Channel IDs (right-click channel → Copy Channel ID)
CHANNEL_DAILY_TIPS=
CHANNEL_GENERAL=
CHANNEL_ANNOUNCEMENTS=
CHANNEL_NEWS=
CHANNEL_SHOWCASE=
CHANNEL_BOT_LOGS=

# CLI path for content generation (optional, defaults to 'claude')
CLAUDE_CLI_PATH=claude

# Content generation timeout in ms (optional, defaults to 60000)
CONTENT_TIMEOUT=60000
